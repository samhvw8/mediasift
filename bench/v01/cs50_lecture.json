        "visual_change",
        "visual_cut"
      ],
      "visual_change": 0.0,
      "audio_change": 0.77,
      "speech_ratio": 0.85,
      "activity": 1.03,
      "keyframes": [
        {
          "t": 255.4,
          "same_as": "frames/f035_00145.60s.jpg"
        }
      ],
      "transcript": "But why do they do that? Well, it turns out when you use base 2, otherwise known as binary, well, it just maps really readily to the real world. Because at the end of the day, what do we all do if you've got a laptop or phone or any device?"
    },
    {
